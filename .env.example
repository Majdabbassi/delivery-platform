# Copy to .env (git-ignored). Every value is optional: docker-compose has working local defaults.
# Anything beyond a local demo needs real values.

# MySQL root password (default: CHANGE_ME). The database is not published outside Docker.
MYSQL_ROOT_PASSWORD=

# Secret that signs the login tokens. Leave empty locally (a development secret is used and the
# backend logs a warning). In production the backend REFUSES to start with a weak or public one.
# Generate one with:  openssl rand -hex 32
JWT_SECRET=

# The Super Admin created on first start (default password: admin123!, public in the README).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Grafana admin password (default: CHANGE_ME)
GRAFANA_PASSWORD=
