# Environment Variables Template
# Copy this file to .env and fill in the actual values
# DO NOT commit .env file to version control

# Database Configuration (MySQL)
DATABASE_URL=jdbc:mysql://localhost:3306/swiftdeliver_db_new
DATABASE_USERNAME=root
DATABASE_PASSWORD=

# JWT Configuration - Generate a strong 256-bit secret
# You can generate one using: openssl rand -base64 32
JWT_SECRET=change_this_to_a_long_random_256_bit_secret_key
JWT_ISSUER=swiftdeliver-backend
JWT_AUDIENCE=swiftdeliver-frontend
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# Admin User Configuration (used to bootstrap the first Super Admin on first startup)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Rate Limiting
RATE_LIMIT_MAX_ATTEMPTS=5
RATE_LIMIT_LOCKOUT_DURATION=15
RATE_LIMIT_CLEANUP_INTERVAL=60

# Password Policy
PASSWORD_MIN_LENGTH=8
PASSWORD_MAX_LENGTH=128
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_DIGITS=true
PASSWORD_REQUIRE_SPECIAL_CHARS=true

# CORS Configuration
CORS_ALLOWED_ORIGIN_1=http://localhost:3000
CORS_ALLOWED_ORIGIN_2=http://localhost:4200
CORS_ALLOWED_ORIGIN_3=https://yourdomain.com

# Audit Configuration
AUDIT_ENABLED=true
AUDIT_LOG_LEVEL=INFO
AUDIT_BATCH_SIZE=100
AUDIT_FLUSH_INTERVAL=30

# Session Configuration
SESSION_TIMEOUT=30
MAX_CONCURRENT_SESSIONS=1

# Cookie Security
COOKIE_SECURE=false
COOKIE_HTTP_ONLY=true

# Development Settings (disable in production)
H2_CONSOLE_ENABLED=false
JPA_SHOW_SQL=false

# Security Features
ENABLE_CSRF=false
ENABLE_FRAME_OPTIONS=true
ENABLE_CONTENT_TYPE_OPTIONS=true
ENABLE_XSS_PROTECTION=true
ENABLE_HSTS=true
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=true

# Encryption
ENCRYPTION_ALGORITHM=AES
ENCRYPTION_KEY_SIZE=256