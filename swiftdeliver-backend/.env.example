# Settings the backend actually reads (see src/main/resources/application.yml).
# Used when you run it without Docker; docker-compose sets the same variables itself.

# Database (MySQL)
DATABASE_URL=jdbc:mysql://localhost:3306/swiftdeliver_db_new
DATABASE_USERNAME=root
DATABASE_PASSWORD=

# Login tokens. The secret must be at least 32 bytes and not a published default, otherwise
# every profile except dev/test refuses to start:  openssl rand -hex 32
JWT_SECRET=
JWT_ISSUER=swiftdeliver-backend
JWT_EXPIRATION=86400000            # access token, ms (24 h)
JWT_REFRESH_EXPIRATION=604800000   # refresh token, ms (7 d)

# Accounts created on first start
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123!
DEMO_PASSWORD=SwiftDeliver@2026!   # password of the seeded demo users

# Browser origins allowed to call the API and open the WebSocket (comma separated)
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost

# Login lockout and per-user order-creation limit
RATE_LIMIT_MAX_ATTEMPTS=5
RATE_LIMIT_LOCKOUT_DURATION=15     # minutes
ORDER_RATE_LIMIT_PER_MINUTE=20

# Optional: serve /actuator on a separate internal port (docker-compose uses 8081 for Prometheus)
# MANAGEMENT_PORT=8081
