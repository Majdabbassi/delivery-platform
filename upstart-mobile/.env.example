# Base URL of the Upstart backend API used by the mobile app.
# Leave unset to use the default (http://10.0.2.2:8080/api, Android emulator loopback).
# On a physical device set this to your machine's LAN IP, e.g.:
#   EXPO_PUBLIC_API_URL=http://192.168.1.10:8080/api
EXPO_PUBLIC_API_URL=http://10.0.2.2:8080/api